<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<Type Name="cpu_info::cpuid_result">
		<DisplayString>A:{e.ax,X} B:{e.bx,X} C:{e.cx,X} D:{e.dx,X}</DisplayString>
	</Type>

	<Type Name="cpu_info::apicid_bit_layout">
		<DisplayString>{domain} =&gt; {shift,d}, {relative_masks}</DisplayString>
	</Type>

	<Type Name="cpu_info::affinity">
		<DisplayString>Grp:{group_id,x}, Pref:{pref_cpu,x}, Mask:</DisplayString>
	</Type>

	<Type Name="cpu_info::cpu_topo">
		<Intrinsic Name="msvc" Expression="(void)(process_affinity.sysAffinity), true" Optional="false"/>
		<DisplayString Condition="msvc() &amp;&amp; (process_affinity.ga.Mask == process_affinity.sysAffinity)"
					   Optional="true">CPUs:{cpu_ids.size()} Domains:{lvl_ids.size()} Mask:'ALL'</DisplayString>
		<DisplayString Condition="msvc() &amp;&amp; (process_affinity.ga.Mask == 0)"
					   Optional="true">CPUs:{cpu_ids.size()} Domains:{lvl_ids.size()} Mask:'NONE'</DisplayString>
		<DisplayString>CPUs:{cpu_ids.size(),d} Domains:{lvl_ids.size(),d} linux</DisplayString>
	</Type>

	<Type Name="cpu_info::cpu_id" ExcludeView="ShowElementsByIndex" Priority="MediumHigh">
		<Intrinsic Name="maxLeaf" Expression="(uint16_t)(_Mypair._Myval2._Myval2._Myhead->_Left->_Myval.second._Mypair._Myval2._Myfirst->e.ax)" Optional="true"/>
		<Intrinsic Name="idLeaf" Expression="(unsigned)(maxLeaf() &lt; 0x1f ? maxLeaf() &lt; 0x0b ? 1 : 0x0b : 0x1f)" Optional="true"/>
		<!-- the following is incorrect in case of larger systems - it simply works with most consumer CPUs -->
		<Intrinsic Name="apicId" Expression="(uint16_t)(_Mypair._Myval2._Myval2._Myhead->_Left->_Parent->_Myval.second[0].e.bx >> 24)" Optional="true"/>
		<DisplayString Optional="true">cpu: #{apicId(),X}  maxLeaf:{maxLeaf(),X}, {_Mypair._Myval2._Myval2._Mysize} leafs</DisplayString>
		<Expand>
			<TreeItems>
				<Size>_Mypair._Myval2._Myval2._Mysize</Size>
				<HeadPointer>_Mypair._Myval2._Myval2._Myhead-&gt;_Parent</HeadPointer>
				<LeftPointer>_Left</LeftPointer>
				<RightPointer>_Right</RightPointer>
				<ValueNode Condition="_Isnil == 0" Name="[{_Myval.first}]">_Myval,view(MapHelper)</ValueNode>
			</TreeItems>
		</Expand>
	</Type>

	<Type Name="std::pair&lt;unsigned int const ,std::vector&lt;cpu_info::cpuid_result, *&gt;&gt;" IncludeView="MapHelper">
		<DisplayString Condition="(second.size() == 1)">{second[0]}</DisplayString>
		<DisplayString>{second.size()} subleafs</DisplayString>
		<Expand><!-- HideRawView="true"-->
			<ArrayItems>
				<Size>second.size()</Size>
				<ValuePointer>second._Mypair._Myval2._Myfirst</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="std::_Tree_iterator&lt;*&gt;">
		<AlternativeType Name="std::_Tree_const_iterator&lt;*&gt;" />
		<SmartPointer Usage="Minimal">_Ptr-&gt;_Isnil ? nullptr : &amp;_Ptr-&gt;_Myval</SmartPointer>
		<DisplayString Condition="_Ptr-&gt;_Isnil == 0">{_Ptr-&gt;_Myval}</DisplayString>
		<DisplayString Condition="_Ptr-&gt;_Isnil != 0">end</DisplayString>
		<Expand>
			<Item Condition="_Ptr-&gt;_Isnil == 0" Name="[ptr]">&amp;_Ptr-&gt;_Myval</Item>
		</Expand>
	</Type>

	<Type Name="std::vector&lt;cpu_info::cpuid_result,*&gt;">
		<Intrinsic Name="size" Expression="(size_t)(_Mypair._Myval2._Mylast - _Mypair._Myval2._Myfirst)" />
		<Intrinsic Name="capacity" Expression="(size_t)(_Mypair._Myval2._Myend - _Mypair._Myval2._Myfirst)" />
		<DisplayString Condition="(size() == 1)">{*_Mypair._Myval2._Myfirst}</DisplayString>
		<DisplayString>cpuids: {size()}</DisplayString>
		<Expand>
			<Item Name="[capacity]" ExcludeView="simple">capacity()</Item>
			<Item Name="[allocator]" ExcludeView="simple">_Mypair</Item>
			<ArrayItems>
				<Size>size()</Size>
				<ValuePointer>_Mypair._Myval2._Myfirst</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

</AutoVisualizer>
